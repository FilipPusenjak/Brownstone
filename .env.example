# ---------------------------------------------------------------------------
# Co-operator environment
#
# Copy to `.env` and fill in. Every variable here is validated at boot by
# src/lib/env.ts — the app refuses to start with a clear message naming what is
# missing rather than failing later with an undefined.
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
# Two roles on purpose. Row-level security is only real if the runtime role
# cannot bypass it, and migrations need an owner that can.
#
# DATABASE_URL   runtime role (cooperator_app). No BYPASSRLS, not table owner.
#                On Vercel this should be the POOLED connection string; add
#                ?pgbouncer=true so Prisma disables prepared statements.
# DIRECT_URL     owner role (cooperator_owner). Direct, unpooled. Used by
#                `prisma migrate` and by the seed.
#
# Run `pnpm db:setup` once against a fresh database to create both roles.
DATABASE_URL="postgresql://cooperator_app:app@localhost:5432/cooperator"
DIRECT_URL="postgresql://cooperator_owner:owner@localhost:5432/cooperator"

# --- Auth ------------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
# Canonical origin. Sign-in links and invitation links are built from this.
AUTH_URL="http://localhost:3000"

# --- Reseeding a deployed instance -----------------------------------------
# The seed truncates every table, User included, which on a hosted instance
# deletes the account you sign in with. Set this to your own address and the
# seed carries that one account — name and password digest — across the reseed,
# and makes it an officer of the first building. Leave it blank on a laptop.
# SEED_DEVELOPER_EMAIL=""
# Optional: sets that account's password during the reseed rather than
# carrying the old one over. Use `pnpm auth:password <email>` instead if you
# would rather not put a password in a file.
# SEED_DEVELOPER_PASSWORD=""

# --- Email -----------------------------------------------------------------
# EMAIL_DRIVER: "catcher" writes .eml files to ./.mail and never touches the
# network. "resend" sends for real. Development defaults to catcher — seed data
# contains addresses that may turn out to belong to real people.
EMAIL_DRIVER="catcher"
EMAIL_FROM="Co-operator <notices@example.com>"
RESEND_API_KEY=""
# Shared secret Resend signs delivery webhooks with. Required when
# EMAIL_DRIVER=resend so the notification log cannot be forged.
RESEND_WEBHOOK_SECRET=""

# --- File storage ----------------------------------------------------------
# STORAGE_DRIVER: "local" keeps uploads on disk under ./storage and signs URLs
# with AUTH_SECRET. "s3" talks to any S3-compatible bucket (Cloudflare R2).
STORAGE_DRIVER="local"
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Serving traffic with NODE_ENV=production and either development driver is
# refused at boot: a deployment that writes notices to a temporary disk reports
# success and sends nothing. The smoke test needs exactly that combination, so
# it sets ALLOW_DEV_DRIVERS_IN_PRODUCTION=1 to lift those two checks. Do not put
# it here. It is ignored outright when VERCEL=1, so it cannot reach a real
# deployment even if someone tries.

# --- Scheduled work --------------------------------------------------------
# Shared secret for POST/GET /api/cron/run. Vercel Cron sends it as a bearer
# token. Generate with: openssl rand -hex 32
CRON_SECRET=""

# --- NYC Open Data ---------------------------------------------------------
# Optional. Prefills unit count, stories, year built, BBL and BIN when a
# building is created. Without a token the endpoints still work at a lower
# rate limit; the new-building form degrades to manual entry either way.
NYC_OPEN_DATA_APP_TOKEN=""

# --- Misc ------------------------------------------------------------------
# Only "development", "test" and "production" are accepted.
NODE_ENV="development"
